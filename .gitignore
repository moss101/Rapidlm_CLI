# Rust
/target/
**/*.rs.bk

# Node / pnpm (SDK workspace)
node_modules/
.pnpm-store/
dist/
coverage/
*.tsbuildinfo

# Local orchestration state (keep workflow scripts)
.grok/rapidlm-v2/

# Cross-process advisory locks for .rapidlm/goal.json and .rapidlm/
# goal-evidence.json (see GoalHost::update / update_evidence / GoalLock) —
# transient coordination files with no meaningful content, never
# themselves part of the persisted goal or evidence contract.
.rapidlm/goal.lock
.rapidlm/goal-evidence.lock
.rapidlm/goal-driver.lock

# Local event-ledger database. Written wherever a command runs — including
# `apps/rapid/` when `cargo test -p rapid --lib` exercises a command that
# opens `.rapidlm/sessions.sqlite` relative to the process cwd — and never
# part of the repository's content.
**/.rapidlm/sessions.sqlite
**/.rapidlm/sessions.sqlite-wal
**/.rapidlm/sessions.sqlite-shm

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~
