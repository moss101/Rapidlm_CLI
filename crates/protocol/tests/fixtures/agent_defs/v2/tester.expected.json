{
  "id": "tester",
  "description": "Runs and triages tests",
  "base_role": "tester",
  "tool_classes": ["read", "exec"],
  "instructions": "Run the suite, then report what failed and why.",
  "model": "fast",
  "reasoning_effort": "low",
  "inputs": ["scope"],
  "outputs": ["summary"],
  "allow_tools": ["shell_exec", "repo_read", "repo_search"],
  "deny_tools": ["workspace_patch"],
  "permission": [["shell_exec(git push*)", "ask"], ["shell_exec(rm *)", "deny"]],
  "max_steps": 16
}
