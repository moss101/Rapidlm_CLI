{
  "name": "@rapidlm/sdk",
  "version": "0.1.0",
  "description": "Public TypeScript SDK for RapidLM kernel IPC/RPC contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "node scripts/generate-wire-types.mjs",
    "generate:check": "node scripts/generate-wire-types.mjs --check",
    "test": "node --experimental-strip-types --test test/generated.test.ts"
  },
  "engines": {
    "node": "24.19.0"
  }
}
