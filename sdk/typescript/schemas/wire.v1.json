{
  "schema": "rapidlm.sdk.wire",
  "schema_version": 1,
  "title": "RapidLM public wire types",
  "description": "Canonical JSON Schema catalog for SDK Event, Error, Session, Agent, Goal, and Tool records.",
  "uuid_pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
  "artifact_id_pattern": "^sha256:[0-9a-f]{64}$",
  "recorded_at_prefix": "YYYY-MM-DDTHH:MM:SS",
  "bounds": {
    "max_message_bytes": 512,
    "max_detail_fields": 16,
    "max_detail_key_bytes": 64,
    "max_detail_value_bytes": 256,
    "max_actor_attr_bytes": 128,
    "max_call_id_bytes": 128,
    "max_task_bytes": 16384,
    "max_summary_bytes": 16384,
    "max_goal_statement_bytes": 16384,
    "max_permissions_profile_bytes": 256,
    "max_criterion_text_bytes": 4096,
    "max_criteria": 64,
    "max_evidence_requirements": 64,
    "max_evidence_kinds": 16,
    "max_evidence": 64,
    "max_artifacts": 64,
    "max_active_agents": 256,
    "max_json_depth": 16,
    "max_json_nodes": 65536,
    "max_decode_bytes": 1048576,
    "max_event_bytes": 4194304,
    "event_envelope_schema": 1,
    "session_snapshot_schema": 1,
    "tool_invocation_schema": 1,
    "tool_result_schema": 1,
    "agent_schema_version": 1,
    "goal_schema_version": 1,
    "agent_spec_schema": "rapidlm.agent_spec",
    "agent_result_schema": "rapidlm.agent_result",
    "goal_snapshot_schema": "rapidlm.goal_snapshot"
  },
  "reserved_detail_keys": [
    "source",
    "cause",
    "causes",
    "inner",
    "raw",
    "exception",
    "backtrace",
    "back_trace",
    "stack",
    "stacktrace",
    "stack_trace",
    "error_chain",
    "errorchain",
    "source_chain",
    "chained"
  ],
  "denied_argument_names": [
    "api_key",
    "authorization",
    "capability_lease",
    "capability_token",
    "cookie",
    "credentials",
    "elevate",
    "force_complete",
    "grant_capability",
    "host_path",
    "lease",
    "override_policy",
    "parent_transcript",
    "password",
    "plaintext",
    "private_key",
    "privileged",
    "raw_adb",
    "secret",
    "secret_plaintext",
    "simctl",
    "skip_evidence",
    "sudo",
    "token",
    "write_owner"
  ],
  "redaction_classes": ["public", "project", "sensitive", "secret"],
  "actor_kinds": ["agent", "human", "external_human", "system"],
  "session_statuses": ["ready", "busy", "paused", "recovering", "closed"],
  "agent_roles": [
    "main",
    "planner",
    "coder",
    "explorer",
    "reviewer",
    "verifier",
    "security_reviewer",
    "context_curator"
  ],
  "agent_states": [
    "queued",
    "starting",
    "running",
    "waiting_tool",
    "waiting_approval",
    "paused",
    "blocked",
    "succeeded",
    "failed",
    "cancelled"
  ],
  "agent_terminal_statuses": ["succeeded", "failed", "cancelled"],
  "goal_states": ["active", "paused", "blocked"],
  "goal_stop_reasons": ["completed", "cancelled", "budget_exhausted", "process_recovered"],
  "tool_result_statuses": ["ok", "denied", "approval_required", "failed"],
  "error_codes": [
    { "code": "config.invalid", "retryable": false },
    { "code": "auth.required", "retryable": false },
    { "code": "session.conflict", "retryable": false },
    { "code": "session.not_found", "retryable": false },
    { "code": "goal.invalid_transition", "retryable": false },
    { "code": "goal.evidence_missing", "retryable": false },
    { "code": "goal.budget_exhausted", "retryable": false },
    { "code": "agent.concurrency_limit", "retryable": true },
    { "code": "context.index_unavailable", "retryable": true },
    { "code": "workspace.preimage_mismatch", "retryable": false },
    { "code": "workspace.merge_conflict", "retryable": false },
    { "code": "policy.denied", "retryable": false },
    { "code": "policy.approval_required", "retryable": false },
    { "code": "policy.lease_invalid", "retryable": false },
    { "code": "sandbox.tier_unavailable", "retryable": false },
    { "code": "process.timeout", "retryable": true },
    { "code": "provider.rate_limited", "retryable": true },
    { "code": "provider.auth_failed", "retryable": false },
    { "code": "provider.context_too_large", "retryable": false },
    { "code": "tool.invalid_arguments", "retryable": false },
    { "code": "browser.stale_observation", "retryable": false },
    { "code": "mobile.capability_unavailable", "retryable": false },
    { "code": "mcp.server_untrusted", "retryable": false },
    { "code": "plugin.capability_denied", "retryable": false },
    { "code": "storage.corrupt", "retryable": false },
    { "code": "internal.unexpected", "retryable": false }
  ],
  "event_kinds": [
    { "kind": "session.created", "family": "session" },
    { "kind": "session.recovered", "family": "session" },
    { "kind": "session.forked", "family": "session" },
    { "kind": "session.closed", "family": "session" },
    { "kind": "turn.started", "family": "turn" },
    { "kind": "turn.interrupted", "family": "turn" },
    { "kind": "turn.completed", "family": "turn" },
    { "kind": "turn.failed", "family": "turn" },
    { "kind": "model.requested", "family": "model" },
    { "kind": "model.stream_delta", "family": "model" },
    { "kind": "model.completed", "family": "model" },
    { "kind": "model.failed", "family": "model" },
    { "kind": "tool.requested", "family": "tool" },
    { "kind": "tool.authorized", "family": "tool" },
    { "kind": "tool.approval_required", "family": "tool" },
    { "kind": "tool.started", "family": "tool" },
    { "kind": "tool.completed", "family": "tool" },
    { "kind": "tool.failed", "family": "tool" },
    { "kind": "tool.denied", "family": "tool" },
    { "kind": "approval.requested", "family": "approval" },
    { "kind": "approval.resolved", "family": "approval" },
    { "kind": "approval.expired", "family": "approval" },
    { "kind": "goal.created", "family": "goal" },
    { "kind": "goal.updated", "family": "goal" },
    { "kind": "goal.blocked", "family": "goal" },
    { "kind": "goal.paused", "family": "goal" },
    { "kind": "goal.resumed", "family": "goal" },
    { "kind": "goal.completed", "family": "goal" },
    { "kind": "goal.cancelled", "family": "goal" },
    { "kind": "goal.budget_updated", "family": "goal" },
    { "kind": "agent.spawned", "family": "agent" },
    { "kind": "agent.started", "family": "agent" },
    { "kind": "agent.state_changed", "family": "agent" },
    { "kind": "agent.result", "family": "agent" },
    { "kind": "agent.cancelled", "family": "agent" },
    { "kind": "workspace.view_created", "family": "workspace" },
    { "kind": "workspace.mutation_detected", "family": "workspace" },
    { "kind": "workspace.patch_staged", "family": "workspace" },
    { "kind": "workspace.transaction_committed", "family": "workspace" },
    { "kind": "workspace.transaction_rolled_back", "family": "workspace" },
    { "kind": "job.started", "family": "job" },
    { "kind": "job.output", "family": "job" },
    { "kind": "job.completed", "family": "job" },
    { "kind": "job.orphan_reconciled", "family": "job" },
    { "kind": "context.indexed", "family": "context" },
    { "kind": "context.retrieved", "family": "context" },
    { "kind": "context.compiled", "family": "context" },
    { "kind": "context.memory_written", "family": "context" },
    { "kind": "evidence.recorded", "family": "evidence" },
    { "kind": "evidence.validated", "family": "evidence" },
    { "kind": "evidence.rejected", "family": "evidence" },
    { "kind": "security.finding", "family": "security" },
    { "kind": "security.scan_completed", "family": "security" },
    { "kind": "artifact.created", "family": "artifact" },
    { "kind": "artifact.redacted", "family": "artifact" },
    { "kind": "artifact.expired", "family": "artifact" },
    { "kind": "agent.pool.background_started", "family": "agent" },
    { "kind": "agent.pool.background_parked", "family": "agent" },
    { "kind": "agent.mail.sent", "family": "agent" },
    { "kind": "agent.mail.dropped", "family": "agent" },
    { "kind": "agent.task_envelope.created", "family": "agent" },
    { "kind": "agent.trajectory_summary.created", "family": "agent" },
    { "kind": "handoff.requested", "family": "handoff" },
    { "kind": "handoff.source_parked", "family": "handoff" },
    { "kind": "handoff.bundle_ready", "family": "handoff" },
    { "kind": "handoff.target_restored", "family": "handoff" },
    { "kind": "handoff.execution_lease_committed", "family": "handoff" },
    { "kind": "handoff.aborted", "family": "handoff" },
    { "kind": "control.transferred_to_human", "family": "control" },
    { "kind": "control.transferred_to_agent", "family": "control" },
    { "kind": "knowledge.proposed", "family": "knowledge" },
