    { "kind": "orchestration.evidence_created", "family": "orchestration" },
    { "kind": "orchestration.check_completed", "family": "orchestration" },
    { "kind": "orchestration.verification_completed", "family": "orchestration" },
    { "kind": "orchestration.gap_created", "family": "orchestration" },
    { "kind": "orchestration.repair_started", "family": "orchestration" },
    { "kind": "orchestration.strategist_invoked", "family": "orchestration" },
