    { "kind": "graph.created", "family": "graph" },
    { "kind": "graph.revision_committed", "family": "graph" },
    { "kind": "graph.proposal_rejected", "family": "graph" },
    { "kind": "graph.node_state_changed", "family": "graph" }
  ],
  "tools": [
    { "name": "repo.search", "description": "hybrid/lexical/structural search" },
    { "name": "repo.read", "description": "bounded file/range/symbol read" },
    { "name": "workspace.patch", "description": "stage semantic patch" },
    { "name": "workspace.status", "description": "diff/view/checkpoint state" },
    { "name": "shell.exec", "description": "supervised command execution" },
    { "name": "agent.spawn", "description": "create isolated subagent" },
    { "name": "agent.result", "description": "inspect/merge typed subagent result" },
    { "name": "goal.update", "description": "machine goal lifecycle/evidence linkage" },
    { "name": "browser.act", "description": "observe/act/verify browser" },
    { "name": "mobile.act", "description": "simulator actions" },
    { "name": "external.call", "description": "MCP/plugin capability proxy" },
    { "name": "evidence.record", "description": "attach verifiable evidence" }
  ]
}
